# =============================================================================
# Board: DDR3 reference clock (differential, 125 MHz).
# N3/N2 comes from the working 100H demo board (its whole IO map - clk50 D18,
# rst C22, uart C24/B24, leds E18/C19/C18/A20 - matches ares_p4_board.fdc),
# and it is the pair that closes pnr on PG2L200H/FBB676.
# Pango's own 676 reference .fdc files use M21/M22 instead; that pair belongs
# to the right-hand DDR3 pin group of their reference design and produced
# "Place-0094 MREGION_CLOCK ... incompatible" with this bottom-left pinout.
# VERIFY N3/N2 against the 200Pro+ schematic; the pin must be the one wired to
# the 125 MHz DDR3 reference oscillator.
# =============================================================================
define_attribute {p:ref_clk_p} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:ref_clk_p} {PAP_IO_LOC} {N3}
define_attribute {p:ref_clk_p} {PAP_IO_VCCIO} {1.5}
define_attribute {p:ref_clk_p} {PAP_IO_STANDARD} {SSTL15D_I}
define_attribute {p:ref_clk_p} {PAP_IO_NONE} {TRUE}
define_attribute {p:ref_clk_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:ref_clk_n} {PAP_IO_LOC} {N2}
define_attribute {p:ref_clk_n} {PAP_IO_VCCIO} {1.5}
define_attribute {p:ref_clk_n} {PAP_IO_STANDARD} {SSTL15D_I}
define_attribute {p:ref_clk_n} {PAP_IO_NONE} {TRUE}
