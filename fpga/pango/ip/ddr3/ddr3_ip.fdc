# =============================================================================
# ddr3_ip.fdc - constraints for the Pango Logos2 HMIC_S DDR3 IP
#                instance "ddr3_test", configured for PG2L200H-6IFBB676 (FBB676, -6)
#
# Generated by ip_generate.exe (IP Compiler 2022.2-SP6.4 build 146967) and then
# reduced to the IP-only part: reference clock, PHY generated clocks, PHY
# placement and the DDR3 device pin table.  The IP instance MUST be named
# I_ips_ddr_top at the top level of the SoC (see the define_attribute {i:...}
# lines below, which use that absolute instance path).
#
# The SoC supplies its own system clock constraint; nothing here depends on it.
# ref_clk (differential, pin ref_clk_p/ref_clk_n) must be 125 MHz.
# =============================================================================
create_clock -name {ref_clk} [get_ports {ref_clk_p}] -period {8.0} -waveform {0 4.0}
create_generated_clock -name {rst_clk} -source [get_ports {ref_clk_p}] [get_pins {I_ips_ddr_top.u_ddrphy_top.rst_clk_gpll/clkout0}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {16}
